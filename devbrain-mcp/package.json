{
  "name": "devbrain-mcp",
  "version": "0.7.1",
  "private": false,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Repository intelligence, trusted execution evidence, deterministic context governance, and read-only Docker inspection MCP server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HERO-FIIFI/DevBrain.git"
  },
  "bugs": {
    "url": "https://github.com/HERO-FIIFI/DevBrain/issues"
  },
  "homepage": "https://github.com/HERO-FIIFI/DevBrain#readme",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "devbrain-mcp": "dist/admin.js",
    "devbrain": "dist/admin.js",
    "devbrain-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "benchmark:refactor-safely:test": "vitest run tests/benchmark",
    "benchmark:refactor-safely:validate": "node benchmarks/refactor-safely/cli.mjs validate",
    "benchmark:refactor-safely:preflight": "node benchmarks/refactor-safely/cli.mjs preflight-model",
    "benchmark:refactor-safely:pilot": "node benchmarks/refactor-safely/cli.mjs pilot",
    "benchmark:refactor-safely:report": "node benchmarks/refactor-safely/cli.mjs report",
    "verify:package": "node scripts/verify-package.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
